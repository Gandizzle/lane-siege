# Copy this to .env (which git ignores) and fill it in. docs/GO-LIVE.md §5.

# The address players connect to: the DNS record you made, without https://.
DOMAIN=play.yourgame.com

# A long random password for the admin page at https://<DOMAIN>/admin.
# Make one with a password manager: 32 characters or more.
ADMIN_TOKEN=

# Later, once RevenueCat is set up (docs/GO-LIVE.md §9). Leave it empty until then.
REVENUECAT_SECRET_KEY=
