{
  "name": "lane-siege",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Competitive lane-defense game. See DESIGN.md for the specification.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "VITE_BASE=./ npm run build && node scripts/prepare-android.mjs",
    "android:open": "cap open android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/headless/run.ts",
    "builders": "tsx src/headless/builders.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "perf": "tsx src/headless/perf.ts",
    "routing": "tsx src/headless/routing.ts",
    "wire": "tsx src/headless/wire.ts",
    "server": "tsx server/index.ts",
    "netcheck": "tsx src/headless/netcheck.ts",
    "lobby": "tsx src/headless/lobby.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "colyseus.js": "^0.16.22",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@colyseus/ws-transport": "^0.16.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "colyseus": "^0.16.5",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
